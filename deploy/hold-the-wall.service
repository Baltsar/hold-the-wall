[Unit]
Description=Hold the Wall
After=network-online.target docker.service
Requires=docker.service

[Service]
User=wall
WorkingDirectory=/opt/hold-the-wall
EnvironmentFile=/opt/hold-the-wall/.env
# Docker only through sudo and the checker deploy/wall-docker: the user is not in the docker group.
Environment=NODE_ENV=production WALL_DATA_DIR=/var/lib/wall WALL_DOCKER=sudo
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
