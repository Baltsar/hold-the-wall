# Vultr Serverless Inference. The key stays in .env on the VM, never in the repository.
VULTR_INFERENCE_KEY=
# A chat model the key can use; list them with: node --env-file=.env scripts/models.mjs
VULTR_MODEL=
# The address in the QR code, e.g. https://wall.example.com
PUBLIC_ORIGIN=
# runsc (gVisor) on the VM if installed, runc otherwise
SANDBOX_RUNTIME=runc
# Header value that lets the team open the show room (300 phones, its own slot)
SHOW_KEY=
# 1 = the door makes the agent root inside its box (design, section 8)
ROOT_DOOR=0
# Where flags and reports are written; defaults to ./var
WALL_DATA_DIR=

# Vultr account API key, only for creating the VM from scripts; never needed by the app
VULTR_API_KEY=
